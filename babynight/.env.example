# ============================================================
# BabyNight — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit the real .env file to git
# ============================================================

# WhatsApp Cloud API — you'll get these from Meta Developer Dashboard
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_ACCESS_TOKEN=your_permanent_access_token_here
WA_VERIFY_TOKEN=choose_any_random_secret_string_here

# Anthropic (Claude) API Key — from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your WhatsApp phone numbers (include country code, no + or spaces)
# e.g. if your number is +972-50-1234567, write 972501234567
PARENT1_PHONE=972XXXXXXXXX
PARENT2_PHONE=972XXXXXXXXX

# Your names (used in responses)
PARENT1_NAME=Ido
PARENT2_NAME=Partner

# Baby details
BABY_NAME=Baby
BABY_BIRTH_DATE=2025-10-15

# Server port (Railway sets this automatically, but you can override for local dev)
PORT=3000
