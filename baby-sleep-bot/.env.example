# Anthropic — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Twilio — from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Your WhatsApp numbers (bot will send proactive messages to these)
# Format: whatsapp:+COUNTRYCODE_NUMBER,whatsapp:+COUNTRYCODE_NUMBER
PARENT_WHATSAPP_NUMBERS=whatsapp:+972501234567,whatsapp:+972509876543

# Optional: map phone numbers to names so the bot knows who sent what
# Format: +COUNTRYCODE_NUMBER=Name,+COUNTRYCODE_NUMBER=Name
PARENT_NAMES=+972501234567=Mum,+972509876543=Dad
